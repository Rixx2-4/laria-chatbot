# URL del backend FastAPI LARIA (sin barra final).
# Producción (Render):
PUBLIC_LARIA_API_URL=https://laria-ia.onrender.com

# Local (opcional, sobrescribe en .env):
# PUBLIC_LARIA_API_URL=http://localhost:8000

# Endpoints del backend:
# Health  → https://laria-ia.onrender.com/health
# Docs    → https://laria-ia.onrender.com/docs
# API     → https://laria-ia.onrender.com/api/v1

# El backend debe incluir este origen en CORS_ORIGINS, p. ej.:
# CORS_ORIGINS=["http://localhost:4321","https://laria-chatbot.vercel.app"]
